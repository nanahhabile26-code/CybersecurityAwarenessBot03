<Window x:Class="CybersecurityAwarenessBot.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Quiz"
        Height="550"
        Width="750"
        WindowStartupLocation="CenterScreen"
        Background="#172033">

    <Grid Margin="25">

        <!-- Quiz Questions -->
        <StackPanel x:Name="QuestionPanel">

            <TextBlock Text="CYBERSECURITY AWARENESS QUIZ"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,20"/>

            <TextBlock x:Name="ProgressText"
                       Foreground="White"
                       FontSize="16"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="ScoreText"
                       Foreground="LightGreen"
                       FontSize="16"
                       Margin="0,0,0,20"/>

            <TextBlock x:Name="QuestionText"
                       Foreground="White"
                       FontSize="20"
                       TextWrapping="Wrap"
                       Margin="0,0,0,25"/>

            <StackPanel x:Name="OptionsPanel"/>

            <TextBlock x:Name="FeedbackText"
                       Foreground="White"
                       FontSize="16"
                       TextWrapping="Wrap"
                       Margin="0,15,0,15"/>

            <Button x:Name="NextButton"
                    Content="Next Question"
                    Height="40"
                    Width="150"
                    HorizontalAlignment="Left"
                    Click="NextButton_Click"
                    Visibility="Collapsed"/>

        </StackPanel>

        <!-- Quiz Results -->
        <StackPanel x:Name="ResultPanel"
                    Visibility="Collapsed"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <TextBlock Text="QUIZ COMPLETED!"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="LightGreen"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

            <TextBlock x:Name="FinalScoreText"
                       Foreground="White"
                       FontSize="22"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock x:Name="FinalFeedbackText"
                       Foreground="White"
                       FontSize="17"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,25"/>

            <Button Content="Play Again"
                    Width="150"
                    Height="40"
                    Margin="0,0,0,10"
                    Click="PlayAgain_Click"/>

            <Button Content="Close"
                    Width="150"
                    Height="40"
                    Click="Close_Click"/>

        </StackPanel>

    </Grid>

</Window>
