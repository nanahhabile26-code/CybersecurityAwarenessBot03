<Window x:Class="CybersecurityAwarenessBot.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Task Assistant"
        Height="650" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="CYBERSECURITY TASK ASSISTANT"
                   Foreground="#00BCD4"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1"
                Background="#161B22"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,15">

            <StackPanel>
                <TextBlock Text="Task Title"
                           Foreground="White"/>

                <TextBox x:Name="TitleBox"
                         Height="35"
                         Margin="0,5,0,10"/>

                <TextBlock Text="Task Description"
                           Foreground="White"/>

                <TextBox x:Name="DescriptionBox"
                         Height="55"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Margin="0,5,0,10"/>

                <TextBlock Text="Reminder Date (Optional)"
                           Foreground="White"/>

                <DatePicker x:Name="ReminderPicker"
                            Margin="0,5,0,10"/>

                <Button Content="Add Task"
                        Height="40"
                        Background="#238636"
                        Foreground="White"
                        Click="AddTask_Click"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="TasksGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Background="White"
                  Margin="0,0,0,15">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding TaskId}"
                                    Width="50"/>

                <DataGridTextColumn Header="Title"
                                    Binding="{Binding Title}"
                                    Width="*"/>

                <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Reminder"
                                    Binding="{Binding ReminderText}"
                                    Width="150"/>

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding StatusText}"
                                    Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <Button Content="Refresh"
                    Width="120"
                    Height="38"
                    Margin="5"
                    Click="Refresh_Click"/>

            <Button Content="Mark Completed"
                    Width="150"
                    Height="38"
                    Margin="5"
                    Background="#238636"
                    Foreground="White"
                    Click="Complete_Click"/>

            <Button Content="Delete Task"
                    Width="120"
                    Height="38"
                    Margin="5"
                    Background="#DA3633"
                    Foreground="White"
                    Click="Delete_Click"/>
        </StackPanel>
    </Grid>
</Window>
